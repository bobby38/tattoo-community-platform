    sortedEvents.forEach(event => {
      const date = new Date(event.start_date);
      const monthKey = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      
      if (!grouped[monthKey]) {
        grouped[monthKey] = [];
      }
      
      grouped[monthKey].push(event);
    });
    
    return grouped;
