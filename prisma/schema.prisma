// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Uses the URL from .env
}

// ENUMS
enum Role {
  USER
  ADMIN
}

enum ReviewTargetType {
  STUDIO
  ARTIST
  POST
}

// MODELS

// --- Core Entities ---

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  // We'll store password hash via Supabase Auth, not directly here
  // password_hash String? @db.VarChar(255)
  role          Role      @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  posts         Post[]
  reviews       Review[]
  favoriteStyles UserStyle[] @relation("UserFavoriteStyles")
  tribes        UserTribe[] @relation("UserTribes")

  @@map("users")
}

model Studio {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(150)
  address   String?  @db.VarChar(255)
  city      String?  @db.VarChar(100)
  lat       Decimal? @db.Decimal
  lng       Decimal? @db.Decimal
  website   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artists   Artist[]
  reviews   Review[] @relation("StudioReviews")
  tags      StudioTag[] @relation("StudioTags")

  @@map("studios")
}

model Artist {
  id        String    @id @default(cuid())
  studioId  String?   @map("studio_id")
  name      String    @db.VarChar(100)
  bio       String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  studio    Studio?    @relation(fields: [studioId], references: [id])
  posts     Post[]     // An artist can be linked to posts
  reviews   Review[]   @relation("ArtistReviews")
  styles    ArtistStyle[] @relation("ArtistStyles")
  contactInfo ContactInfo? @relation("ArtistContact") // Relation to ContactInfo

  @@map("artists")
}

// --- Supporting Entities ---

model ContactInfo {
  id          String    @id @default(cuid())
  artistId    String    @unique @map("artist_id") // Each artist has one contact info block
  instagram   String?   @db.VarChar(100)
  phone       String?   @db.VarChar(50)
  email       String?   @db.VarChar(150)
  website     String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  artist      Artist    @relation("ArtistContact", fields: [artistId], references: [id])

  @@map("contact_info")
}

model Style {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artists   ArtistStyle[] @relation("ArtistStyles")
  tribes    TribeStyle[]  @relation("TribeStyles")
  users     UserStyle[]   @relation("UserFavoriteStyles")

  @@map("styles")
}

model Tribe {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  iconUrl   String?  @db.VarChar(255) @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  styles    TribeStyle[] @relation("TribeStyles")
  users     UserTribe[]  @relation("UserTribes")

  @@map("tribes")
}

model Post {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  artistId  String?  @map("artist_id") // Artist is optional
  imageUrl  String   @db.VarChar(255) @map("image_url")
  caption   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id])
  artist    Artist?  @relation(fields: [artistId], references: [id])
  tags      PostTag[] @relation("PostTags")
  reviews   Review[] @relation("PostReviews")

  @@map("posts")
}

model Review {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  targetType ReviewTargetType @map("target_type")
  targetId  String           @map("target_id") // Using String to reference CUIDs
  rating    Int              @db.SmallInt 
  comment   String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user   User @relation(fields: [userId], references: [id])

  // Explicit relations based on targetType (handled in application logic or potentially via views/triggers if needed for DB-level constraints)
  // We add relations here for Prisma Client typing, actual FK constraint isn't enforced by this alone
  studio Studio? @relation("StudioReviews", fields: [targetId], references: [id], map: "fk_review_studio") 
  artist Artist? @relation("ArtistReviews", fields: [targetId], references: [id], map: "fk_review_artist") 
  post   Post?   @relation("PostReviews", fields: [targetId], references: [id], map: "fk_review_post")   

  @@index([targetType, targetId])
  @@map("reviews")
}

model Event {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(150)
  description String?   @db.Text
  venue       String?   @db.VarChar(255)
  dateFrom    DateTime  @map("date_from") @db.Date // Using DateTime, map to Date in DB
  dateTo      DateTime? @map("date_to") @db.Date   // Using DateTime, map to Date in DB
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sponsors EventSponsor[] @relation("EventSponsors")

  @@map("events")
}

model Sponsor {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  logoUrl   String?  @db.VarChar(255) @map("logo_url")
  website   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events    EventSponsor[] @relation("EventSponsors")

  @@map("sponsors")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50) // e.g., "body-part:arm", "style:color"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts   PostTag[] @relation("PostTags")
  studios StudioTag[] @relation("StudioTags")

  @@map("tags")
}

// --- Join Tables ---

model ArtistStyle {
  artistId String @map("artist_id")
  styleId  String @map("style_id")
  assignedAt DateTime @default(now())
  assignedBy String? // Optional: Track who assigned

  artist Artist @relation("ArtistStyles", fields: [artistId], references: [id])
  style  Style  @relation("ArtistStyles", fields: [styleId], references: [id])

  @@id([artistId, styleId])
  @@map("artist_styles")
}

model TribeStyle {
  tribeId String @map("tribe_id")
  styleId String @map("style_id")
  assignedAt DateTime @default(now())

  tribe Tribe @relation("TribeStyles", fields: [tribeId], references: [id])
  style Style @relation("TribeStyles", fields: [styleId], references: [id])

  @@id([tribeId, styleId])
  @@map("tribe_styles")
}

model UserStyle {
  userId String @map("user_id")
  styleId String @map("style_id")
  score   Int?   // Optional score 1-10
  assignedAt DateTime @default(now())

  user  User  @relation("UserFavoriteStyles", fields: [userId], references: [id])
  style Style @relation("UserFavoriteStyles", fields: [styleId], references: [id])

  @@id([userId, styleId])
  @@map("user_styles")
}

model UserTribe {
  userId String @map("user_id")
  tribeId String @map("tribe_id")
  joinedAt DateTime @default(now())

  user  User  @relation("UserTribes", fields: [userId], references: [id])
  tribe Tribe @relation("UserTribes", fields: [tribeId], references: [id])

  @@id([userId, tribeId])
  @@map("user_tribes")
}

model PostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")
  assignedAt DateTime @default(now())

  post Post @relation("PostTags", fields: [postId], references: [id])
  tag  Tag  @relation("PostTags", fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@map("post_tags")
}

model StudioTag {
  studioId String @map("studio_id")
  tagId    String @map("tag_id")
  assignedAt DateTime @default(now())

  studio Studio @relation("StudioTags", fields: [studioId], references: [id])
  tag    Tag    @relation("StudioTags", fields: [tagId], references: [id])

  @@id([studioId, tagId])
  @@map("studio_tags")
}

model EventSponsor {
  eventId   String @map("event_id")
  sponsorId String @map("sponsor_id")
  assignedAt DateTime @default(now())

  event   Event   @relation("EventSponsors", fields: [eventId], references: [id])
  sponsor Sponsor @relation("EventSponsors", fields: [sponsorId], references: [id])

  @@id([eventId, sponsorId])
  @@map("event_sponsors")
}
